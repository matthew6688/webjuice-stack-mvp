{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "block_id": "faq",
  "block_name": "FAQ",
  "purpose": "6 mandatory roofing FAQ topics (price · license · free_quote · duration · warranty · materials) per niche-spec §7.",
  "required_on": ["home", "service", "contact"],
  "data_od_id": "faq",
  "type": "object",
  "required": ["heading", "items"],
  "properties": {
    "heading": { "type": "string", "minLength": 4, "maxLength": 40 },
    "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "question", "answer"],
        "properties": {
          "id": {
            "enum": ["price", "license", "free_quote", "duration", "warranty", "materials", "service_area", "emergency", "insurance"]
          },
          "question": { "type": "string", "minLength": 10, "maxLength": 140 },
          "answer": { "type": "string", "minLength": 40, "maxLength": 600, "description": "1-3 sentences. For 'price': use ranges not exact numbers. For 'license': use correct state authority verbatim." },
          "_source": { "type": "string" }
        }
      }
    }
  },
  "validation_hooks": [
    "correct_state_authority",
    "no_fabricated_data",
    "no_generic_copy",
    "paragraph_length"
  ]
}
