{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "block_id": "service-areas",
  "block_name": "Service Areas",
  "purpose": "List 4-12 suburbs/regions the business serves; supports local SEO + service_area pages.",
  "required_on": ["home"],
  "recommended_on": ["service", "contact"],
  "data_od_id": "service-areas",
  "type": "object",
  "required": ["heading", "areas"],
  "properties": {
    "heading": { "type": "string", "minLength": 8, "maxLength": 60 },
    "intro": { "type": "string", "maxLength": 200 },
    "areas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 50 },
          "page_slug": { "type": "string", "description": "Optional · /service-area/<slug> for dedicated pages" },
          "_source": { "type": "string", "description": "verified:scraped | verified:gbp | derived:radius" }
        }
      }
    },
    "map_embed": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["google-maps", "static-image", "none"] },
        "src": { "type": "string" }
      }
    }
  },
  "validation_hooks": ["no_fabricated_data", "local_seo_present"]
}
